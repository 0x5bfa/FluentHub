<navigation:ScreenView
	x:Class="FluentHub.Features.SignIn.Views.IntroPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:navigation="using:FluentHub.Shell.Navigation"
	xmlns:uc="using:FluentHub.Shared.Controls.Views"
	Background="Transparent">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="48" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid x:Name="AppTitleBar" Background="Transparent">
			<uc:TitleBar Margin="16,4,0,0" />
		</Grid>

		<ScrollViewer
			Grid.Row="1"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<Grid
				MinHeight="600"
				Margin="36,20,36,28"
				RowSpacing="12">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="1">
					<!--  Welcome  -->
					<StackPanel
						x:Name="WelcomePanel"
						MaxWidth="360"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						x:Load="{x:Bind ViewModel.IsWelcomeStage, Mode=OneWay}"
						Spacing="12">
						<Viewbox
							Width="96"
							Height="96"
							Margin="0,0,0,12">
							<Image Source="ms-appx:///Assets/AppTiles/Release/StoreLogo.scale-400.png" />
						</Viewbox>
						<TextBlock
							HorizontalAlignment="Center"
							Style="{StaticResource TitleTextBlockStyle}"
							Text="Welcome to FluentHub" />
						<TextBlock
							Margin="0,0,0,24"
							HorizontalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Explore repositories, issues, pull requests, and more from a native Windows app."
							TextAlignment="Center"
							TextWrapping="Wrap" />
						<Button
							HorizontalAlignment="Stretch"
							Command="{x:Bind ViewModel.AuthorizeWithBrowserCommand}"
							Content="Sign in with GitHub"
							Style="{StaticResource AccentButtonStyle}" />
						<Button
							HorizontalAlignment="Stretch"
							Content="GitHub Enterprise"
							IsEnabled="False" />
						<TextBlock
							Margin="0,18,0,0"
							HorizontalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="Your password is entered only on GitHub." />
					</StackPanel>

					<!--  Device code  -->
					<StackPanel
						x:Name="DeviceCodePanel"
						MaxWidth="380"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						x:Load="{x:Bind ViewModel.IsDeviceCodeStage, Mode=OneWay}"
						Spacing="12">
						<Button
							Margin="-12,0,0,4"
							HorizontalAlignment="Left"
							Background="Transparent"
							BorderThickness="0"
							Command="{x:Bind ViewModel.ReturnToWelcomeCommand}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<FontIcon FontSize="14" Glyph="&#xE72B;" />
								<TextBlock Text="Back" />
							</StackPanel>
						</Button>
						<TextBlock
							HorizontalAlignment="Center"
							Style="{StaticResource TitleTextBlockStyle}"
							Text="Sign in to GitHub" />
						<TextBlock
							Margin="0,0,0,8"
							HorizontalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Enter this one-time code on GitHub to continue."
							TextAlignment="Center"
							TextWrapping="Wrap" />

						<Border
							Padding="16"
							Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="{StaticResource OverlayCornerRadius}">
							<Grid ColumnSpacing="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontFamily="Cascadia Mono"
									FontSize="36"
									FontWeight="SemiBold"
									IsTextSelectionEnabled="True"
									Text="{x:Bind ViewModel.DeviceUserCode, Mode=OneWay}" />

								<uc:CopyButton
									x:Name="CopyCodeButton"
									Grid.Column="1"
									Width="36"
									Height="32"
									Click="OnCopyDeviceCodeButtonClick"
									CopiedMessage="SSH URL copied"
									IsEnabled="{x:Bind ViewModel.IsDeviceAuthorizationAvailable, Mode=OneWay}"
									ToolTipService.ToolTip="Copy code">
									<FontIcon FontSize="14" Glyph="&#xE8C8;" />
								</uc:CopyButton>
							</Grid>
						</Border>

						<Button
							HorizontalAlignment="Stretch"
							Command="{x:Bind ViewModel.OpenDeviceVerificationUriCommand}"
							Content="Open GitHub again"
							IsEnabled="{x:Bind ViewModel.IsDeviceAuthorizationAvailable, Mode=OneWay}"
							Style="{StaticResource AccentButtonStyle}" />
						<StackPanel
							Margin="0,4,0,0"
							HorizontalAlignment="Center"
							Orientation="Horizontal"
							Spacing="10">
							<ProgressRing
								Width="18"
								Height="18"
								IsActive="{x:Bind ViewModel.IsTaskLoading, Mode=OneWay}" />
							<TextBlock
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind ViewModel.DeviceAuthorizationStatus, Mode=OneWay}"
								TextWrapping="Wrap" />
						</StackPanel>
					</StackPanel>

					<!--  Sync  -->
					<StackPanel
						x:Name="SyncingPanel"
						MaxWidth="360"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						x:Load="{x:Bind ViewModel.IsSyncingStage, Mode=OneWay}"
						Spacing="14">
						<ProgressRing
							Width="72"
							Height="72"
							Margin="0,0,0,18"
							IsActive="True" />
						<TextBlock
							HorizontalAlignment="Center"
							Style="{StaticResource TitleTextBlockStyle}"
							Text="Authorization confirmed" />
						<TextBlock
							HorizontalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind ViewModel.DeviceAuthorizationStatus, Mode=OneWay}"
							TextAlignment="Center"
							TextWrapping="Wrap" />
						<ProgressBar Margin="0,20,0,0" IsIndeterminate="True" />
					</StackPanel>

					<!--  Success  -->
					<StackPanel
						x:Name="SuccessPanel"
						MaxWidth="360"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						x:Load="{x:Bind ViewModel.IsSuccessStage, Mode=OneWay}"
						Spacing="12">
						<Border
							Width="72"
							Height="72"
							Margin="0,0,0,18"
							Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
							CornerRadius="100">
							<FontIcon
								FontSize="24"
								Foreground="{ThemeResource SystemFillColorSuccessBrush}"
								Glyph="&#xE8FB;" />
						</Border>
						<TextBlock
							HorizontalAlignment="Center"
							Style="{StaticResource TitleTextBlockStyle}"
							Text="You're all set" />
						<TextBlock
							Margin="0,0,0,16"
							HorizontalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Your GitHub account is ready to use in FluentHub."
							TextAlignment="Center"
							TextWrapping="Wrap" />
						<Border
							Padding="16"
							Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="8">
							<Grid ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="44" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Border
									Width="40"
									Height="40"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									CornerRadius="20">
									<SymbolIcon Symbol="Contact" />
								</Border>
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SignedInLogin, Mode=OneWay}" />
									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="GitHub account" />
								</StackPanel>
							</Grid>
						</Border>
						<Button
							Margin="0,8,0,0"
							HorizontalAlignment="Stretch"
							Click="OnContinueButtonClick"
							Content="Continue"
							Style="{StaticResource AccentButtonStyle}" />
						<Button
							HorizontalAlignment="Stretch"
							Command="{x:Bind ViewModel.ReturnToWelcomeCommand}"
							Content="Add another account" />
					</StackPanel>
				</Grid>

				<TextBlock
					Grid.Row="2"
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					IsTextSelectionEnabled="True"
					Style="{StaticResource CaptionTextBlockStyle}"
					Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
			</Grid>
		</ScrollViewer>
	</Grid>
</navigation:ScreenView>
