<UserControl
	x:Class="FluentHub.Controls.UserContributionGraph"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:coreModels="using:FluentHub.Core.Application.Models"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	d:DesignHeight="300"
	d:DesignWidth="1000"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<converters:ContributionLevelToBrushConverter x:Key="ContributionLevelToBrushConverter" />
			<converters:ContributionWeeksToWidthConverter x:Key="ContributionWeeksToWidthConverter" />
			<converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />

			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="ContributionGraphDayBackground" Color="#EBEDF0" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel1Background" Color="#9BE9A8" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel2Background" Color="#40C463" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel3Background" Color="#30A14E" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel4Background" Color="#216E39" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<StaticResource x:Key="ContributionGraphDayBackground" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel1Background" Color="#0E4429" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel2Background" Color="#006D32" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel3Background" Color="#26A641" />
					<SolidColorBrush x:Key="ContributionGraphDayLevel4Background" Color="#39D353" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid
		Background="{ThemeResource LayerFillColorDefaultBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="{StaticResource OverlayCornerRadius}"
		Visibility="{x:Bind Calendar, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Padding="16,8,16,4">
			<TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
				<Run Text="{x:Bind Calendar.TotalContributions, Mode=OneWay}" />
				<Run Text=" contributions in the last year" />
			</TextBlock>
		</Grid>

		<MenuFlyoutSeparator Grid.Row="1" />

		<ScrollViewer
			Grid.Row="2"
			HorizontalScrollBarVisibility="Auto"
			HorizontalScrollMode="Enabled"
			VerticalScrollBarVisibility="Disabled"
			VerticalScrollMode="Disabled"
			ZoomMode="Disabled">
			<Grid
				Margin="16,12"
				HorizontalAlignment="Left"
				ColumnSpacing="8"
				RowSpacing="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="18" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ItemsRepeater
					Grid.Column="1"
					ItemsSource="{x:Bind Calendar.Months, Mode=OneWay}">
					<ItemsRepeater.Layout>
						<StackLayout Orientation="Horizontal" Spacing="0" />
					</ItemsRepeater.Layout>
					<DataTemplate x:DataType="coreModels:ContributionCalendarMonth">
						<TextBlock
							Width="{x:Bind TotalWeeks, Converter={StaticResource ContributionWeeksToWidthConverter}, Mode=OneWay}"
							VerticalAlignment="Center"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="{x:Bind Name, Mode=OneWay}" />
					</DataTemplate>
				</ItemsRepeater>

				<Grid Grid.Row="1" RowSpacing="4">
					<Grid.RowDefinitions>
						<RowDefinition Height="14" />
						<RowDefinition Height="14" />
						<RowDefinition Height="14" />
						<RowDefinition Height="14" />
						<RowDefinition Height="14" />
						<RowDefinition Height="14" />
						<RowDefinition Height="14" />
					</Grid.RowDefinitions>
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Center"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Mon" />
					<TextBlock
						Grid.Row="3"
						VerticalAlignment="Center"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Wed" />
					<TextBlock
						Grid.Row="5"
						VerticalAlignment="Center"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Fri" />
				</Grid>

				<ItemsRepeater
					x:Name="ContributionDaysRepeater"
					Grid.Row="1"
					Grid.Column="1"
					Height="122"
					ItemsSource="{x:Bind Items, Mode=OneWay}">
					<ItemsRepeater.Layout>
						<toolkit:WrapLayout
							HorizontalSpacing="4"
							Orientation="Vertical"
							VerticalSpacing="4" />
					</ItemsRepeater.Layout>
					<DataTemplate x:DataType="coreModels:ContributionCalendarItem">
						<Border
							Width="14"
							Height="14"
							AutomationProperties.Name="{x:Bind Description, Mode=OneTime}"
							Background="{x:Bind ContributionLevel, Converter={StaticResource ContributionLevelToBrushConverter}, Mode=OneTime}"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="4"
							IsHitTestVisible="{x:Bind IsValid, Mode=OneTime}"
							ToolTipService.ToolTip="{x:Bind Description, Mode=OneTime}"
							Visibility="{x:Bind IsValid, Converter={StaticResource ObjectToBoolConverter}, Mode=OneTime}" />
					</DataTemplate>
				</ItemsRepeater>
			</Grid>
		</ScrollViewer>

		<MenuFlyoutSeparator Grid.Row="3" />

		<Grid Grid.Row="4" Margin="16,8,16,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock VerticalAlignment="Center">
				<Hyperlink NavigateUri="https://docs.github.com/en/account-and-profile/reference/contribution-graph-troubleshooting">
					<Run Text="Learn how GitHub counts contributions." />
				</Hyperlink>
			</TextBlock>

			<StackPanel
				Grid.Column="1"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="4">
				<TextBlock
					Margin="0,2,0,0"
					VerticalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondary}"
					Style="{StaticResource CaptionTextBlockStyle}"
					Text="Less" />
				<Border
					Width="14"
					Height="14"
					Background="{ThemeResource ContributionGraphDayBackground}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="4" />
				<Border
					Width="14"
					Height="14"
					Background="{ThemeResource ContributionGraphDayLevel1Background}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="4" />
				<Border
					Width="14"
					Height="14"
					Background="{ThemeResource ContributionGraphDayLevel2Background}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="4" />
				<Border
					Width="14"
					Height="14"
					Background="{ThemeResource ContributionGraphDayLevel3Background}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="4" />
				<Border
					Width="14"
					Height="14"
					Background="{ThemeResource ContributionGraphDayLevel4Background}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="4" />
				<TextBlock
					Margin="0,2,0,0"
					VerticalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondary}"
					Style="{StaticResource CaptionTextBlockStyle}"
					Text="More" />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
