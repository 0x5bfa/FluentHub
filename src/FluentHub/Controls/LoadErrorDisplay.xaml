<UserControl
	x:Class="FluentHub.Controls.LoadErrorDisplay"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:localization="using:FluentHub.Localization"
	x:Name="Root">

	<Grid Padding="32">
		<StackPanel
			MaxWidth="560"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="8">
			<PathIcon
				Width="32"
				Height="32"
				HorizontalAlignment="Center"
				Data="{controls:OcticonData Name=Alert24}"
				Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="36"
				Style="{StaticResource BodyStrongTextBlockStyle}"
				Text="{localization:Localized ResourceKey=Common.SomethingWentWrong}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Style="{StaticResource BodyTextBlockStyle}"
				Text="{x:Bind ErrorMessage, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<Button
				HorizontalAlignment="Center"
				AutomationProperties.Name="{localization:Localized ResourceKey=Common.RetryLoading}"
				Command="{x:Bind RetryCommand, Mode=OneWay}"
				Content="{localization:Localized ResourceKey=Common.TryAgain}" />
		</StackPanel>
	</Grid>
</UserControl>
