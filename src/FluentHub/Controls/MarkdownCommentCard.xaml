<UserControl
	x:Class="FluentHub.Controls.MarkdownCommentCard"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:markdown="using:CommunityToolkit.WinUI.Controls"
	x:Name="Root">

	<Border
		Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="8">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<controls:Avatar
						VerticalAlignment="Center"
						Alt="{x:Bind AuthorName, Mode=OneWay}"
						Size="24"
						Src="{x:Bind AvatarUrl, Mode=OneWay}" />
					<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind AuthorName, Mode=OneWay}" />
					<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ActionText, Mode=OneWay}" />
					<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DateText, Mode=OneWay}" />
					<TextBlock
						x:Name="EditedTextBlock"
						x:Load="{x:Bind IsEdited, Mode=OneWay}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Text="edited" />
				</StackPanel>
			</Grid>

			<Rectangle
				Grid.Row="1"
				Height="1"
				Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

			<Grid Grid.Row="2" Padding="16">
				<markdown:MarkdownTextBlock Text="{x:Bind Body, Mode=OneWay}" />
			</Grid>
		</Grid>
	</Border>
</UserControl>
