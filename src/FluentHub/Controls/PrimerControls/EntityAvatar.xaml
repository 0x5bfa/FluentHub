<UserControl
	x:Class="FluentHub.Controls.PrimerControls.EntityAvatar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:FluentHub.Helpers">

	<Border
		x:Name="AvatarBorder"
		Width="{x:Bind Size, Mode=OneWay}"
		Height="{x:Bind Size, Mode=OneWay}"
		Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Image
			helpers:GitHubImageCache.Source="{x:Bind Source, Mode=OneWay}"
			Stretch="UniformToFill" />
	</Border>
</UserControl>
