<UserControl
	x:Class="FluentHub.Shared.Controls.Views.TimelineList"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:FluentHub.Models"
	xmlns:modelsV4="using:FluentHub.Core.Application.Models"
	xmlns:primer="using:FluentHub.Shared.Controls.Views.PrimerControls"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:uc="using:FluentHub.Shared.Controls.Views"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
			<converters:IssueCommentToIssueCommentBlockViewModelConverter x:Key="IssueCommentToIssueCommentBlockViewModelConverter" />
			<converters:HexColorCodeToSolidColorBrushConverter x:Key="HexColorCodeToSolidColorBrushConverter" />
			<converters:DecimalToSubjectNumberConverter x:Key="DecimalToSubjectNumberConverter" />

			<DataTemplate x:Key="AddedToProjectEventDataTemplate" x:DataType="modelsV4:AddedToProjectEvent">
				<primer:Timeline>
					<primer:Timeline.Badge>
						<FontIcon
							FontFamily="{StaticResource Octicons}"
							FontSize="14"
							Glyph="&#xEA48;" />
					</primer:Timeline.Badge>
					<primer:Timeline.Body>
						<Grid ColumnSpacing="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<uc:UserAvatar
								VerticalAlignment="Top"
								Label="{x:Bind Actor.Login}"
								Size="20"
								AvatarUrl="{x:Bind Actor.AvatarUrl}" />
							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorSecondary}"
								IsTextSelectionEnabled="True"
								Style="{StaticResource BodyTextBlockStyle}"
								Text="added this to a project" />
							<TextBlock
								Grid.Column="2"
								Foreground="{ThemeResource TextFillColorSecondary}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Text="{x:Bind CreatedAtHumanized}" />
						</Grid>
					</primer:Timeline.Body>
				</primer:Timeline>
			</DataTemplate>

			<DataTemplate x:Key="AssignedEventDataTemplate" x:DataType="modelsV4:AssignedEvent">
				<primer:Timeline>
					<primer:Timeline.Badge>
						<FontIcon
							FontFamily="{StaticResource Octicons}"
							FontSize="14"
							Glyph="&#xEA38;" />
					</primer:Timeline.Badge>
					<primer:Timeline.Body>
						<Grid ColumnSpacing="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<uc:UserAvatar
								VerticalAlignment="Top"
								Label="{x:Bind Actor.Login}"
								Size="20"
								AvatarUrl="{x:Bind Actor.AvatarUrl}" />
							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								IsTextSelectionEnabled="True"
								Style="{StaticResource BodyTextBlockStyle}">
								<Run Foreground="{ThemeResource TextFillColorSecondary}" Text="assigned" />
								<Run FontWeight="SemiBold" Text="{x:Bind Assignee.User.Login}" />
							</TextBlock>
							<TextBlock
								Grid.Column="2"
								Foreground="{ThemeResource TextFillColorSecondary}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Text="{x:Bind CreatedAtHumanized}" />
						</Grid>
					</primer:Timeline.Body>
				</primer:Timeline>
			</DataTemplate>

			<DataTemplate x:Key="ClosedEventDataTemplate" x:DataType="modelsV4:ClosedEvent">
				<Grid>
					<toolkit:SwitchPresenter TargetType="x:String" Value="{x:Bind StateReason.ToString(), Mode=OneWay}">
						<toolkit:Case Value="NotPlanned">
							<primer:Timeline BadgeBackground="{ThemeResource TextFillColorSecondaryBrush}">
								<primer:Timeline.Badge>
									<FontIcon
										FontFamily="{StaticResource Octicons}"
										FontSize="14"
										Glyph="&#xEA84;" />
								</primer:Timeline.Badge>
								<primer:Timeline.Body>
									<Grid ColumnSpacing="4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<uc:UserAvatar
											VerticalAlignment="Top"
											Label="{x:Bind Actor.Login}"
											Size="20"
											AvatarUrl="{x:Bind Actor.AvatarUrl}" />
										<TextBlock
											Grid.Column="1"
											VerticalAlignment="Center"
											Foreground="{ThemeResource TextFillColorSecondary}"
											IsTextSelectionEnabled="True"
											Style="{StaticResource BodyTextBlockStyle}"
											Text="closed this as not planned" />
										<TextBlock
											Grid.Column="2"
											Foreground="{ThemeResource TextFillColorSecondary}"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="{x:Bind CreatedAtHumanized}" />
									</Grid>
								</primer:Timeline.Body>
							</primer:Timeline>
						</toolkit:Case>
						<toolkit:Case Value="Completed">
							<primer:Timeline BadgeBackground="{ThemeResource AccentTextFillColorPrimaryBrush}">
								<primer:Timeline.Badge>
									<FontIcon
										FontFamily="{StaticResource Octicons}"
										FontSize="14"
										Glyph="&#xE9E6;" />
								</primer:Timeline.Badge>
								<primer:Timeline.Body>
									<Grid ColumnSpacing="4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<uc:UserAvatar
											VerticalAlignment="Top"
											Label="{x:Bind Actor.Login}"
											Size="20"
											AvatarUrl="{x:Bind Actor.AvatarUrl}" />
										<StackPanel
											Grid.Column="1"
											Orientation="Horizontal"
											Spacing="4">
											<TextBlock
												VerticalAlignment="Center"
												Foreground="{ThemeResource TextFillColorSecondary}"
												IsTextSelectionEnabled="True"
												Style="{StaticResource BodyTextBlockStyle}"
												Text="closed this as completed" />
										</StackPanel>
										<TextBlock
											Grid.Column="2"
											Foreground="{ThemeResource TextFillColorSecondary}"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="{x:Bind CreatedAtHumanized}" />
									</Grid>
								</primer:Timeline.Body>
							</primer:Timeline>
						</toolkit:Case>
					</toolkit:SwitchPresenter>
				</Grid>
			</DataTemplate>

