<UserControl
	x:Class="FluentHub.UserControls.FeedBlocks.SingleCommitBlock"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:FluentHub.Helpers"
	xmlns:local="using:FluentHub.UserControls.FeedBlocks"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:contracts="using:FluentHub.Core.Contracts"
	xmlns:primer="using:FluentHub.UserControls.PrimerControls"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	d:DesignHeight="300"
	d:DesignWidth="400"
	mc:Ignorable="d">

	<Grid Padding="16,12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Spacing="4">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Details.Commits.Count, Mode=OneWay}" />
			<TextBlock VerticalAlignment="Center" Text="commit" />
		</StackPanel>

		<MenuFlyoutSeparator Grid.Row="1" Margin="-16,8" />

		<StackPanel Grid.Row="2">
			<ItemsRepeater ItemsSource="{x:Bind ViewModel.Details.Commits, Mode=OneWay}">
				<ItemsRepeater.Layout>
					<StackLayout Orientation="Vertical" Spacing="8" />
				</ItemsRepeater.Layout>
				<DataTemplate x:DataType="contracts:ActivityCommit">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<Border
							Width="20"
							Height="20"
							HorizontalAlignment="Left"
							Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
							CornerRadius="10">
							<Image
								Width="20"
								Height="20"
								helpers:GitHubImageCache.Source="{x:Bind User.AvatarUrl, Mode=OneWay}" />
						</Border>

						<Button
							VerticalAlignment="Center"
							Content="{x:Bind Sha, Mode=OneWay}"
							FontSize="12"
							FontWeight="SemiBold"
							Style="{StaticResource LinkLikeButtonStyle}" />

						<TextBlock Foreground="{ThemeResource TextFillColorSecondary}" Text="{x:Bind Message, Mode=OneWay}" />

					</StackPanel>
				</DataTemplate>
			</ItemsRepeater>
		</StackPanel>

	</Grid>
</UserControl>
