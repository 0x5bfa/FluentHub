<UserControl
	x:Class="FluentHub.Views.InboxView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:viewModels="using:FluentHub.ViewModels">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Padding="32,24,32,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Spacing="4">
				<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Inbox" />
				<TextBlock
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="Notifications from the repositories you follow."
					TextWrapping="Wrap" />
			</StackPanel>

			<Button
				Grid.Column="1"
				Command="{x:Bind ViewModel.RefreshCommand}"
				Content="Refresh">
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Key="R" Modifiers="Control" />
				</Button.KeyboardAccelerators>
			</Button>
		</Grid>

		<TextBlock
			Grid.Row="1"
			Margin="32,20,32,12"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="{x:Bind ViewModel.UnreadSummary, Mode=OneWay}" />

		<Grid Grid.Row="2">
			<ProgressRing
				x:Name="LoadingIndicator"
				Width="40"
				Height="40"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
				IsActive="True" />

			<ListView
				x:Name="NotificationList"
				Margin="0,0,0,24"
				x:Load="{x:Bind ViewModel.HasItems, Mode=OneWay}"
				IsItemClickEnabled="True"
				IsMultiSelectCheckBoxEnabled="True"
				ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
				SelectionMode="Multiple">
				<ListView.ItemContainerStyle>
					<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
						<Setter Property="Margin" Value="28,0" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="viewModels:InboxItemViewModel">
						<Grid Padding="12,10" ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Ellipse
								x:Name="UnreadIndicator"
								Grid.Column="0"
								Width="8"
								Height="8"
								Margin="0,6,0,0"
								HorizontalAlignment="Center"
								x:Load="{x:Bind IsUnread}"
								Fill="{ThemeResource AccentFillColorDefaultBrush}" />

							<PathIcon
								Grid.Column="0"
								Width="16"
								Height="16"
								VerticalAlignment="Top"
								Data="{x:Bind IconGeometry, Mode=OneWay}" />

							<StackPanel Grid.Column="1" Spacing="2">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="{x:Bind RepositoryName}" />
								<TextBlock
									MaxLines="2"
									Text="{x:Bind Title}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="Wrap" />
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									MaxLines="2"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="{x:Bind Reason}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="Wrap" />
							</StackPanel>

							<TextBlock
								Grid.Column="2"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Text="{x:Bind UpdatedAt}"
								TextTrimming="CharacterEllipsis"
								TextWrapping="Wrap" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<StackPanel
				x:Name="EmptyState"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
				Spacing="8">
				<PathIcon
					Width="24"
					Height="24"
					HorizontalAlignment="Center"
					Data="{controls:OcticonData Name=Inbox16}" />
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource SubtitleTextBlockStyle}"
					Text="You're all caught up" />
				<TextBlock
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="There are no notifications to show."
					TextWrapping="Wrap" />
			</StackPanel>

			<StackPanel
				x:Name="ErrorState"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
				Spacing="8">
				<SymbolIcon
					HorizontalAlignment="Center"
					Foreground="{ThemeResource SystemFillColorCriticalBrush}"
					Symbol="Important" />
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource SubtitleTextBlockStyle}"
					Text="Inbox unavailable" />
				<TextBlock
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
					TextWrapping="Wrap" />
				<Button
					HorizontalAlignment="Center"
					Command="{x:Bind ViewModel.RefreshCommand}"
					Content="Try again" />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
