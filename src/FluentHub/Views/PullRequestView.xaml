<UserControl
	x:Class="FluentHub.Views.PullRequestView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:localization="using:FluentHub.Extensions"
	xmlns:viewModels="using:FluentHub.ViewModels"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	x:Name="Root">

	<wctcontrols:SwitchPresenter
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch"
		TargetType="viewModels:LoadingState"
		Value="{x:Bind ViewModel.LoadingState, Mode=OneWay}">
		<wctcontrols:Case Value="Loading">
			<Grid MinHeight="160">
				<ProgressRing
					Width="40"
					Height="40"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsActive="True" />
			</Grid>
		</wctcontrols:Case>
		<wctcontrols:Case Value="Loaded">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel Padding="24">
					<HyperlinkButton
						Margin="-8,-4,0,-4"
						Padding="8,4"
						Content="{x:Bind ViewModel.RepositoryName, Mode=OneWay}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

					<TextBlock
						Margin="0,4"
						MaxLines="3"
						Style="{StaticResource TitleTextBlockStyle}"
						Text="{x:Bind ViewModel.Title, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="Wrap" />

					<controls:StateLabel
						Margin="0,4"
						Status="{x:Bind ViewModel.StateStatus, Mode=OneWay}"
						Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" />

					<Rectangle
						Height="1"
						Margin="0,4"
						Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<controls:MarkdownCommentCard
						Margin="0,4,0,0"
						ActionText="{localization:Localized ResourceKey=Timeline.Opened}"
						AuthorName="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
						AvatarUrl="{x:Bind ViewModel.AuthorAvatarUrl, Mode=OneWay}"
						Body="{x:Bind ViewModel.Body, Mode=OneWay}"
						DateText="{x:Bind ViewModel.CreatedAt, Mode=OneWay}"
						IsEdited="{x:Bind ViewModel.IsBodyEdited, Mode=OneWay}" />

					<Border
						Width="2"
						Height="8"
						Margin="23,0,0,0"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<controls:Timeline ItemsSource="{x:Bind ViewModel.TimelineItems, Mode=OneWay}" />
				</StackPanel>
			</ScrollViewer>
		</wctcontrols:Case>
		<wctcontrols:Case Value="Error">
			<controls:LoadErrorDisplay ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryCommand="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />
		</wctcontrols:Case>
	</wctcontrols:SwitchPresenter>
</UserControl>
