<UserControl
	x:Class="FluentHub.Views.PullRequestView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:viewModels="using:FluentHub.ViewModels"
	x:Name="Root">

	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Padding="24" Spacing="16">
			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<PathIcon
					Width="32"
					Height="32"
					Data="{controls:OcticonData Name=GitPullRequest24}"
					Foreground="{ThemeResource InboxStatusOpenBrush}" />
				<StackPanel Grid.Column="1" Spacing="2">
					<TextBlock
						Style="{StaticResource TitleTextBlockStyle}"
						Text="{x:Bind ViewModel.Title, Mode=OneWay}"
						TextWrapping="Wrap" />
					<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}" />
				</StackPanel>
			</Grid>

			<ProgressRing
				x:Name="LoadingIndicator"
				Width="40"
				Height="40"
				HorizontalAlignment="Center"
				x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
				IsActive="True" />

			<StackPanel
				x:Name="ContentPanel"
				x:Load="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
				Spacing="16">
				<controls:MarkdownCommentCard
					ActionText="opened"
					AuthorName="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
					AvatarUrl="{x:Bind ViewModel.AuthorAvatarUrl, Mode=OneWay}"
					Body="{x:Bind ViewModel.Body, Mode=OneWay}"
					DateText="{x:Bind ViewModel.CreatedAt, Mode=OneWay}"
					IsEdited="{x:Bind ViewModel.IsBodyEdited, Mode=OneWay}" />

				<controls:Timeline ItemsSource="{x:Bind ViewModel.TimelineItems, Mode=OneWay}" />
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button
						x:Name="AuthorButton"
						x:Load="{x:Bind ViewModel.HasAuthor, Mode=OneWay}"
						Click="OnAuthorClick"
						Content="{x:Bind ViewModel.AuthorLogin, Mode=OneWay}" />
					<Button
						x:Name="RepositoryButton"
						Click="OnRepositoryClick"
						Content="Repository" />
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="State" />
					<TextBlock Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" />
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Branches" />
					<TextBlock Text="{x:Bind ViewModel.BranchSummary, Mode=OneWay}" TextWrapping="Wrap" />
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Changes" />
					<TextBlock Text="{x:Bind ViewModel.ChangeSummary, Mode=OneWay}" TextWrapping="Wrap" />
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Updated" />
					<TextBlock Text="{x:Bind ViewModel.UpdatedAt, Mode=OneWay}" />
				</StackPanel>
			</StackPanel>

			<StackPanel
				x:Name="ErrorPanel"
				HorizontalAlignment="Center"
				x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
				Spacing="8">
				<SymbolIcon
					HorizontalAlignment="Center"
					Foreground="{ThemeResource SystemFillColorCriticalBrush}"
					Symbol="Important" />
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource SubtitleTextBlockStyle}"
					Text="Pull request unavailable" />
				<TextBlock
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
					TextWrapping="Wrap" />
				<Button
					x:Name="RetryButton"
					HorizontalAlignment="Center"
					Command="{x:Bind ViewModel.RetryCommand}"
					Content="Try again" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
