<UserControl
	x:Class="FluentHub.Views.ExternalRouteView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:extensions="using:FluentHub.Extensions"
	xmlns:localization="using:FluentHub.Extensions">

	<StackPanel
		Padding="24"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		Spacing="12">
		<PathIcon
			Width="32"
			Height="32"
			HorizontalAlignment="Center"
			Data="{extensions:OcticonData Name=LinkExternal24}"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		<TextBlock
			HorizontalAlignment="Center"
			Style="{StaticResource TitleTextBlockStyle}"
			Text="{x:Bind Title, Mode=OneWay}"
			TextWrapping="Wrap" />
		<Button
			x:Name="OpenButton"
			HorizontalAlignment="Center"
			Click="OnOpenClick"
			Content="{localization:Localized ResourceKey=Common.OpenOnGitHub}" />
	</StackPanel>
</UserControl>
