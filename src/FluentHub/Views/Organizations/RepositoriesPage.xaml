<navigation:NavigableView
	x:Class="FluentHub.Views.Organizations.RepositoriesPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bbvm="using:FluentHub.ViewModels.Controls.BlockButtons"
	xmlns:block="using:FluentHub.Controls.BlockButtons"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:FluentHub.Helpers"
	xmlns:local="using:FluentHub.Views.Organizations"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ov="using:FluentHub.Controls.Overview"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:uc="using:FluentHub.Controls"
	xmlns:navigation="using:FluentHub.Controls.Navigation"
	mc:Ignorable="d">

	<navigation:NavigableView.Resources>
		<converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
	</navigation:NavigableView.Resources>

	<Grid>

		<Grid x:Name="RootContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
			<ScrollViewer ViewChanged="OnScrollViewerViewChanged">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<ov:OrganizationProfileOverview
						x:Name="OrganizationProfileOverview"
						Margin="32,32,32,0"
						ViewModel="{x:Bind ViewModel.OrganizationProfileOverviewViewModel, Mode=OneWay}" />

					<Grid Grid.Row="1" Margin="32,32,32,32">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Grid
							Grid.Row="0"
							Margin="0,8,0,16"
							RowSpacing="8">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<AutoSuggestBox
								x:Name="SearchRepositoriesTextBox"
								PlaceholderText="Search repositories"
								QuerySubmitted="OnSearchQuerySubmitted" />

							<StackPanel
								Grid.Row="1"
								Orientation="Horizontal"
								Spacing="8">

								<ComboBox
									x:Name="TypeFilterBox"
									MinWidth="160"
									Header="Type"
									ItemsSource="{x:Bind ViewModel.TypeFilterOptions, Mode=OneWay}"
									SelectedIndex="0"
									SelectionChanged="OnFilterSelectionChanged" />

								<ComboBox
									x:Name="LanguageFilterBox"
									MinWidth="160"
									Header="Language"
									DropDownOpened="OnLanguageDropDownOpened"
									ItemsSource="{x:Bind ViewModel.LanguageFilterOptions, Mode=OneWay}"
									SelectedIndex="0"
									SelectionChanged="OnFilterSelectionChanged" />

								<ComboBox
									x:Name="SortFilterBox"
									MinWidth="140"
									Header="Sort"
									ItemsSource="{x:Bind ViewModel.SortFilterOptions, Mode=OneWay}"
									SelectedIndex="0"
									SelectionChanged="OnFilterSelectionChanged" />

							</StackPanel>
						</Grid>

						<Grid Grid.Row="1">
							<ItemsRepeater
								ItemsSource="{x:Bind ViewModel.Repositories, Mode=OneWay}"
								VerticalCacheLength="2">
								<ItemsRepeater.Layout>
									<StackLayout Orientation="Vertical" Spacing="4" />
								</ItemsRepeater.Layout>
								<DataTemplate x:DataType="bbvm:RepoBlockButtonViewModel">
									<block:RepoBlockButton
										x:Name="RepositoryBlock"
										VerticalAlignment="Stretch"
										ViewModel="{x:Bind}" />
								</DataTemplate>
							</ItemsRepeater>

							<toolkit:SwitchPresenter
								Grid.RowSpan="3"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								TargetType="x:Boolean"
								Value="{x:Bind ViewModel.LoadOrganizationRepositoriesPageCommand.IsRunning, Mode=OneWay}">

								<toolkit:Case Value="False">
									<toolkit:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind ViewModel.LoadOrganizationRepositoriesPageCommand.ExecutionTask.IsFaulted, Mode=OneWay}">
										<toolkit:Case Value="True">
											<HyperlinkButton Command="{x:Bind ViewModel.LoadOrganizationRepositoriesPageCommand}">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<FontIcon FontSize="16" Glyph="&#xE149;" />
													<TextBlock Text="Refresh" />
												</StackPanel>
											</HyperlinkButton>
										</toolkit:Case>

										<toolkit:Case Value="False">
											<toolkit:SwitchPresenter
												Margin="0,24"
												HorizontalAlignment="Center"
												VerticalAlignment="Stretch"
												TargetType="x:Boolean"
												Value="{x:Bind ViewModel.OAuthAppIsRestrictedByOrgSettings, Mode=OneWay}">
												<toolkit:Case Value="True">
													<StackPanel>
														<TextBlock
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Text="Organization OAuth restriction is enabled in this organization." />
														<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
															<Run>For more info, visit</Run>
															<Hyperlink NavigateUri="https://docs.github.com/articles/restricting-access-to-your-organization-s-data/">the GitHub documentation</Hyperlink>
															<Run>.</Run>
														</TextBlock>
													</StackPanel>
												</toolkit:Case>

												<toolkit:Case Value="False">
													<toolkit:SwitchPresenter TargetType="x:Int32" Value="{x:Bind ViewModel.Repositories.Count, Mode=OneWay}">
														<toolkit:Case Value="0">
															<TextBlock
																x:Name="NoPinnedItemsInRepoBlockTextBlock"
																HorizontalAlignment="Center"
																VerticalAlignment="Center"
																Text="No repositories" />
														</toolkit:Case>
													</toolkit:SwitchPresenter>
												</toolkit:Case>
											</toolkit:SwitchPresenter>
										</toolkit:Case>
									</toolkit:SwitchPresenter>
								</toolkit:Case>

							</toolkit:SwitchPresenter>
						</Grid>
					</Grid>
				</Grid>
			</ScrollViewer>
		</Grid>

		<Grid x:Name="ErrorDisplayingContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Mode=OneWay}">
			<uc:LoadErrorDisplay
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				TaskException="{x:Bind ViewModel.TaskException, Mode=OneWay}">
				<uc:LoadErrorDisplay.Action>
					<Grid>
						<Button
							Margin="0,24,0,0"
							HorizontalAlignment="Center"
							Command="{x:Bind ViewModel.LoadOrganizationRepositoriesPageCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="16" Glyph="&#xE149;" />
								<TextBlock Text="{helpers:ResourceString Name=TryAgainWithCap}" />
							</StackPanel>
						</Button>
					</Grid>
				</uc:LoadErrorDisplay.Action>
			</uc:LoadErrorDisplay>
		</Grid>

	</Grid>
</navigation:NavigableView>
