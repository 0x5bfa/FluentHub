<UserControl
	x:Class="FluentHub.Views.RepositoryView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:extensions="using:FluentHub.Extensions"
	xmlns:localization="using:FluentHub.Extensions"
	xmlns:markdown="using:CommunityToolkit.WinUI.Controls"
	xmlns:viewModels="using:FluentHub.ViewModels"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls">

	<wctcontrols:SwitchPresenter
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch"
		TargetType="viewModels:LoadingState"
		Value="{x:Bind ViewModel.LoadingState, Mode=OneWay}">
		<wctcontrols:Case Value="Loading">
			<Grid MinHeight="160">
				<ProgressRing
					Width="40"
					Height="40"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsActive="True" />
			</Grid>
		</wctcontrols:Case>
		<wctcontrols:Case Value="Loaded">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel Padding="24" Spacing="8">
					<Grid Margin="0,0,0,8" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<PathIcon
							Width="32"
							Height="32"
							Data="{extensions:OcticonData Name=Repo24}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						<StackPanel Grid.Column="1" Spacing="2">
							<TextBlock
								Style="{StaticResource TitleTextBlockStyle}"
								Text="{x:Bind ViewModel.Name, Mode=OneWay}"
								TextWrapping="Wrap" />
							<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.FullName, Mode=OneWay}" />
						</StackPanel>
					</Grid>

					<Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<StackPanel Spacing="16">
						<markdown:MarkdownTextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Click="OnIssuesClick" Content="{localization:Localized ResourceKey=RepositoryItemListViewModel.IssuesTitle}" />
							<Button Click="OnPullRequestsClick" Content="{localization:Localized ResourceKey=RepositoryItemListViewModel.PullRequestsTitle}" />
							<Button Click="OnDiscussionsClick" Content="{localization:Localized ResourceKey=RepositoryItemListViewModel.DiscussionsTitle}" />
							<Button Click="OnActionsClick" Content="{localization:Localized ResourceKey=Actions.Title}" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="16">
							<TextBlock Text="{x:Bind ViewModel.OpenIssues, Mode=OneWay}" />
							<TextBlock Text="{localization:Localized ResourceKey=Common.OpenIssues}" />
							<TextBlock Text="{x:Bind ViewModel.OpenPullRequests, Mode=OneWay}" />
							<TextBlock Text="{localization:Localized ResourceKey=Common.OpenPullRequests}" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="16">
							<TextBlock Text="{x:Bind ViewModel.Stars, Mode=OneWay}" />
							<TextBlock Text="{localization:Localized ResourceKey=Common.Stars}" />
							<TextBlock Text="{x:Bind ViewModel.Forks, Mode=OneWay}" />
							<TextBlock Text="{localization:Localized ResourceKey=Common.Forks}" />
						</StackPanel>
						<TextBlock Text="{x:Bind ViewModel.DefaultBranch, Mode=OneWay}" />
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</wctcontrols:Case>
		<wctcontrols:Case Value="Error">
			<controls:LoadErrorDisplay ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryCommand="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />
		</wctcontrols:Case>
	</wctcontrols:SwitchPresenter>
</UserControl>
