<views:LocatablePage
	x:Class="FluentHub.Views.Repositories.Issues.IssuePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:FluentHub.Helpers"
	xmlns:local="using:FluentHub.Views.Repositories.Issues"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:FluentHub.Models"
	xmlns:modelsV4="using:FluentHub.Octokit.Models.v4"
	xmlns:ov="using:FluentHub.UserControls.Overview"
	xmlns:primer="using:FluentHub.UserControls.PrimerControls"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:uc="using:FluentHub.UserControls"
	xmlns:views="using:FluentHub.Views"
	mc:Ignorable="d">

	<views:LocatablePage.Resources>
		<ResourceDictionary>
			<converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
			<converters:HexColorCodeToSolidColorBrushConverter x:Key="HexColorCodeToSolidColorBrushConverter" />
			<converters:DecimalToSubjectNumberConverter x:Key="DecimalToSubjectNumberConverter" />
		</ResourceDictionary>
	</views:LocatablePage.Resources>

	<Grid>

		<Grid x:Name="RootContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Overview  -->
					<Grid
						Grid.Row="0"
						Padding="32,24,32,12"
						ColumnSpacing="12"
						RowSpacing="12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock
							x:Name="IssueTitleTextBlock"
							IsTextSelectionEnabled="True"
							Style="{StaticResource TitleTextBlockStyle}"
							ToolTipService.ToolTip="{x:Bind ViewModel.IssueItem.Title, Mode=OneWay}">
							<Run FontWeight="SemiBold" Text="{x:Bind ViewModel.IssueItem.Title, Mode=OneWay}" />
							<Run
								FontWeight="Normal"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind ViewModel.IssueItem.Number, Converter={StaticResource DecimalToSubjectNumberConverter}, Mode=OneWay}" />
						</TextBlock>

						<StackPanel
							Grid.Row="1"
							Orientation="Horizontal"
							Spacing="8">
							<toolkit:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind ViewModel.IssueItem.Closed, Mode=OneWay}">
								<toolkit:Case Value="True">
									<primer:StateLabel Status="IssueClosed" ToolTipService.ToolTip="This issue has been closed." />
								</toolkit:Case>
								<toolkit:Case Value="False">
									<primer:StateLabel Status="IssueOpen" ToolTipService.ToolTip="This issue is still open." />
								</toolkit:Case>
							</toolkit:SwitchPresenter>
						</StackPanel>

						<Grid
							Grid.RowSpan="2"
							Grid.Column="1"
							HorizontalAlignment="Right"
							VerticalAlignment="Top">
							<Button
								Width="36"
								Height="32"
								Padding="0"
								VerticalAlignment="Center"
								ToolTipService.ToolTip="More option">
								<FontIcon FontSize="16" Glyph="&#xE10C;" />
								<Button.Flyout>
									<MenuFlyout Placement="BottomEdgeAlignedRight">
										<MenuFlyoutItem IsEnabled="False" Text="Edit title" />
										<MenuFlyoutItem IsEnabled="False" Text="Subscribe" />
										<MenuFlyoutItem IsEnabled="False" Text="Lock" />
										<MenuFlyoutItem IsEnabled="False" Text="Report" />
										<MenuFlyoutSubItem IsEnabled="False" Text="Close Issue">
											<MenuFlyoutSubItem.Items>
												<MenuFlyoutItem IsEnabled="False" Text="Completed" />
												<MenuFlyoutItem IsEnabled="False" Text="Not planned" />
											</MenuFlyoutSubItem.Items>
										</MenuFlyoutSubItem>
									</MenuFlyout>
								</Button.Flyout>
							</Button>
						</Grid>

					</Grid>

					<Rectangle
						Grid.Row="1"
						Height="1"
						Margin="24,0"
						Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<Grid Grid.Row="2" Padding="24,0,24,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition
								Width="*"
								MinWidth="214"
								MaxWidth="400" />
						</Grid.ColumnDefinitions>

						<StackPanel x:Name="IssueContentPanel">

							<Border
								Width="1.5"
								Height="16"
								Margin="36,0,0,0"
								HorizontalAlignment="Left"
								Background="{ThemeResource PrimerBorderMuted}" />

							<uc:TimelineList ItemsSource="{x:Bind ViewModel.TimelineItems, Mode=OneWay}" />

							<Border
								Width="1.5"
								Height="16"
								Margin="36,0,0,0"
								HorizontalAlignment="Left"
								Background="{ThemeResource PrimerBorderMuted}" />
						</StackPanel>

						<StackPanel
							x:Name="IssueDetailsSidebar"
							Grid.Column="1"
							Margin="16,32,0,0"
							Spacing="12">

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Assignees" />
								</StackPanel>

								<Grid>

									<ItemsRepeater ItemsSource="{x:Bind ViewModel.IssueItem.Assignees.Nodes, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Orientation="Vertical" Spacing="6" />
										</ItemsRepeater.Layout>
										<DataTemplate x:DataType="modelsV4:User">
											<primer:Avatar
												HorizontalAlignment="Left"
												Label="{x:Bind Login, Mode=OneWay}"
												Source="{x:Bind AvatarUrl, Mode=OneWay}" />
										</DataTemplate>
									</ItemsRepeater>

									<TextBlock
										x:Name="IssueDetailsSidebarNoAssigneesTextBlock"
										x:Load="{x:Bind ViewModel.IssueItem.Assignees.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No assignees" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Labels" />
								</StackPanel>

								<Grid>

									<ItemsRepeater ItemsSource="{x:Bind ViewModel.IssueItem.Labels.Nodes, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Orientation="Vertical" Spacing="6" />
										</ItemsRepeater.Layout>
										<DataTemplate x:DataType="modelsV4:Label">
											<primer:IssueLabelToken
												HorizontalAlignment="Left"
												FillColor="{x:Bind Color, Converter={StaticResource HexColorCodeToSolidColorBrushConverter}}"
												Text="{x:Bind Name}" />
										</DataTemplate>
									</ItemsRepeater>

									<TextBlock
										x:Name="IssueDetailsSidebarNoLabelsTextBlock"
										x:Load="{x:Bind ViewModel.IssueItem.Labels.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No labels" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Projects" />
								</StackPanel>


								<StackPanel>

									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondary}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No projects" />

								</StackPanel>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Milestone" />
								</StackPanel>

								<Grid>
									<Grid
										x:Name="IssueDetailsSidebarMilestoneVisualGrid"
										Padding="16,8,16,16"
										x:Load="{x:Bind ViewModel.IssueItem.Milestone, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}"
										Background="{ThemeResource LayerFillColorDefaultBrush}"
										BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
										BorderThickness="1"
										CornerRadius="4"
										RowSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<TextBlock
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Style="{StaticResource BodyStrongTextBlockStyle}"
											Text="{x:Bind ViewModel.IssueItem.Milestone.Title, Mode=OneWay}" />
										<ProgressBar
											Grid.Row="1"
											Maximum="100"
											Value="{x:Bind ViewModel.IssueItem.Milestone.ProgressPercentage, Mode=OneWay}" />
									</Grid>


									<TextBlock
										x:Name="IssueDetailsSidebarNoMilestoneTextBlock"
										x:Load="{x:Bind ViewModel.IssueItem.Milestone, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No milestone" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Development" />
								</StackPanel>


								<StackPanel>

									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondary}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="None" />

								</StackPanel>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Notifications" />
								</StackPanel>


								<StackPanel>

									<Button
										HorizontalAlignment="Stretch"
										Content="Subscribe"
										IsEnabled="False" />

								</StackPanel>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Participants" />
								</StackPanel>


								<Grid>

									<ItemsRepeater ItemsSource="{x:Bind ViewModel.IssueItem.Participants.Nodes, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Orientation="Horizontal" Spacing="8" />
										</ItemsRepeater.Layout>
										<DataTemplate x:DataType="modelsV4:User">
											<primer:Avatar
												HorizontalAlignment="Left"
												Size="28"
												Source="{x:Bind AvatarUrl, Mode=OneWay}" />
										</DataTemplate>
									</ItemsRepeater>

									<TextBlock
										x:Name="IssueDetailsSidebarNoParticipantsTextBlock"
										x:Load="{x:Bind ViewModel.IssueItem.Participants.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No participants" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

						</StackPanel>

					</Grid>

					<Grid
						Grid.Row="3"
						Margin="24,0,24,24"
						Background="{ThemeResource LayerFillColorDefaultBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<Grid>
							<NavigationView
								Margin="12,4,24,4"
								IsBackButtonVisible="Collapsed"
								IsSettingsVisible="False"
								PaneDisplayMode="Top">
								<NavigationView.MenuItems>
									<NavigationViewItem
										Content="Write"
										IsEnabled="False"
										IsSelected="True" />
									<NavigationViewItem Content="Preview" IsEnabled="False" />
								</NavigationView.MenuItems>
								<NavigationView.PaneFooter>
									<StackPanel Orientation="Horizontal" Spacing="4">
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xE9CD;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xEAA7;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xEA0F;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xE968;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xEA50;" />
										</Button>
									</StackPanel>
								</NavigationView.PaneFooter>
							</NavigationView>
						</Grid>

						<MenuFlyoutSeparator Grid.Row="1" />

						<Grid
							Grid.Row="2"
							Height="256"
							Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
							<TextBox
								Margin="12"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								PlaceholderText="Leave a comment"
								Text="{x:Bind ViewModel.CommentBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>

						<Grid
							Grid.Row="3"
							Padding="12,0,12,12"
							Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

							<StackPanel
								HorizontalAlignment="Right"
								Orientation="Horizontal"
								Spacing="8">
								<Button
									Command="{x:Bind ViewModel.ToggleIssueStateCommand}"
									Content="{x:Bind ViewModel.IssueStateButtonText, Mode=OneWay}" />
								<Button
									Content="Comment"
									Command="{x:Bind ViewModel.AddIssueCommentCommand}"
									Style="{StaticResource AccentButtonStyle}" />
							</StackPanel>
						</Grid>

					</Grid>
				</Grid>
			</ScrollViewer>
		</Grid>

		<Grid x:Name="ErrorDisplayingContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Mode=OneWay}">
			<uc:LoadErrorDisplay
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				TaskException="{x:Bind ViewModel.TaskException, Mode=OneWay}">
				<uc:LoadErrorDisplay.Action>
					<Grid>
						<Button
							Margin="0,24,0,0"
							HorizontalAlignment="Center"
							Command="{x:Bind ViewModel.LoadRepositoryIssuePageCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="16" Glyph="&#xE149;" />
								<TextBlock Text="{helpers:ResourceString Name=TryAgainWithCap}" />
							</StackPanel>
						</Button>
					</Grid>
				</uc:LoadErrorDisplay.Action>
			</uc:LoadErrorDisplay>
		</Grid>

	</Grid>
</views:LocatablePage>
