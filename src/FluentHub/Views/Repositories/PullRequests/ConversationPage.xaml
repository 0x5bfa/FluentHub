<views:LocatablePage
	x:Class="FluentHub.Views.Repositories.PullRequests.ConversationPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:FluentHub.Helpers"
	xmlns:local="using:FluentHub.Views.Repositories.PullRequests"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:FluentHub.Models"
	xmlns:modelsV4="using:FluentHub.Octokit.Models.v4"
	xmlns:ov="using:FluentHub.UserControls.Overview"
	xmlns:primer="using:FluentHub.UserControls.PrimerControls"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:uc="using:FluentHub.UserControls"
	xmlns:views="using:FluentHub.Views"
	mc:Ignorable="d">

	<views:LocatablePage.Resources>
		<ResourceDictionary>
			<converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
			<converters:HexColorCodeToSolidColorBrushConverter x:Key="HexColorCodeToSolidColorBrushConverter" />
		</ResourceDictionary>
	</views:LocatablePage.Resources>

	<Grid>

		<Grid x:Name="RootContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
			<ScrollViewer>
				<Grid Padding="32,24,32,32">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<ov:PullRequestOverview Grid.Row="1" ViewModel="{x:Bind ViewModel.PullRequestOverviewViewModel, Mode=OneWay}" />

					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition
								Width="*"
								MinWidth="214"
								MaxWidth="400" />
						</Grid.ColumnDefinitions>

						<StackPanel x:Name="PullRequestContentPanel">

							<Border
								Width="1.5"
								Height="16"
								Margin="36,0,0,0"
								HorizontalAlignment="Left"
								Background="{ThemeResource PrimerBorderMuted}" />

							<uc:TimelineList ItemsSource="{x:Bind ViewModel.TimelineItems, Mode=OneWay}" />

							<Border
								Width="1.5"
								Height="16"
								Margin="36,0,0,0"
								HorizontalAlignment="Left"
								Background="{ThemeResource PrimerBorderMuted}" />

						</StackPanel>

						<StackPanel
							x:Name="PullRequestDetailsSidebar"
							Grid.Column="1"
							Margin="16,32,0,0"
							Spacing="12">

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Reviews" />
								</StackPanel>

								<Grid>

									<StackPanel Spacing="6">
										<ItemsRepeater ItemsSource="{x:Bind ViewModel.PullItem.LatestReviews.Nodes, Mode=OneWay}">
											<ItemsRepeater.Layout>
												<StackLayout Orientation="Vertical" Spacing="6" />
											</ItemsRepeater.Layout>
											<DataTemplate x:DataType="modelsV4:PullRequestReview">
												<primer:Avatar
													HorizontalAlignment="Left"
													Label="{x:Bind Author.Login, Mode=OneWay}"
													Source="{x:Bind Author.AvatarUrl, Mode=OneWay}" />
											</DataTemplate>
										</ItemsRepeater>
										<ItemsRepeater ItemsSource="{x:Bind ViewModel.PullItem.ReviewRequests.Nodes, Mode=OneWay}">
											<ItemsRepeater.Layout>
												<StackLayout Orientation="Vertical" Spacing="6" />
											</ItemsRepeater.Layout>
											<DataTemplate x:DataType="modelsV4:ReviewRequest">
												<primer:Avatar
													HorizontalAlignment="Left"
													Label="{x:Bind RequestedReviewer.User.Login, Mode=OneWay}"
													Source="{x:Bind RequestedReviewer.User.AvatarUrl, Mode=OneWay}" />
											</DataTemplate>
										</ItemsRepeater>
									</StackPanel>

									<Grid x:Name="PullRequestDetailsSidebarNoReviewersGrid" x:Load="{x:Bind ViewModel.PullItem.ReviewRequests.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
										<TextBlock
											x:Name="PullRequestDetailsSidebarNoReviewersTextBlock"
											x:Load="{x:Bind ViewModel.PullItem.LatestReviews.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="No reviewers" />
									</Grid>
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Assignees" />
								</StackPanel>

								<Grid>

									<ItemsRepeater ItemsSource="{x:Bind ViewModel.PullItem.Assignees.Nodes, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Orientation="Vertical" Spacing="6" />
										</ItemsRepeater.Layout>
										<DataTemplate x:DataType="modelsV4:User">
											<primer:Avatar
												HorizontalAlignment="Left"
												Label="{x:Bind Login, Mode=OneWay}"
												Source="{x:Bind AvatarUrl, Mode=OneWay}" />
										</DataTemplate>
									</ItemsRepeater>

									<TextBlock
										x:Name="PullRequestDetailsSidebarNoAssigneesTextBlock"
										x:Load="{x:Bind ViewModel.PullItem.Assignees.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No assignees" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Labels" />
								</StackPanel>

								<Grid>

									<ItemsRepeater ItemsSource="{x:Bind ViewModel.PullItem.Labels.Nodes, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Orientation="Vertical" Spacing="6" />
										</ItemsRepeater.Layout>
										<DataTemplate x:DataType="modelsV4:Label">
											<primer:IssueLabelToken
												HorizontalAlignment="Left"
												FillColor="{x:Bind Color, Converter={StaticResource HexColorCodeToSolidColorBrushConverter}}"
												Text="{x:Bind Name}" />
										</DataTemplate>
									</ItemsRepeater>

									<TextBlock
										x:Name="PullRequestDetailsSidebarNoLabelsTextBlock"
										x:Load="{x:Bind ViewModel.PullItem.Labels.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No labels" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Projects" />
								</StackPanel>

								<StackPanel>

									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondary}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No projects" />

								</StackPanel>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Milestone" />
								</StackPanel>

								<Grid>
									<Grid
										x:Name="IssueDetailsSidebarMilestoneVisualGrid"
										Padding="16,8,16,16"
										x:Load="{x:Bind ViewModel.PullItem.Milestone, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}"
										Background="{ThemeResource LayerFillColorDefaultBrush}"
										BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
										BorderThickness="1"
										CornerRadius="4"
										RowSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<TextBlock
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Style="{StaticResource BodyStrongTextBlockStyle}"
											Text="{x:Bind ViewModel.PullItem.Milestone.Title, Mode=OneWay}" />
										<ProgressBar
											Grid.Row="1"
											Maximum="100"
											Value="{x:Bind ViewModel.PullItem.Milestone.ProgressPercentage, Mode=OneWay}" />
									</Grid>


									<TextBlock
										x:Name="PullRequestDetailsSidebarNoMilestoneTextBlock"
										x:Load="{x:Bind ViewModel.PullItem.Milestone, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No milestone" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Development" />
								</StackPanel>

								<StackPanel>

									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondary}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No development" />

								</StackPanel>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Notifications" />
								</StackPanel>


								<StackPanel>

									<Button
										HorizontalAlignment="Stretch"
										Command="{x:Bind ViewModel.ToggleSubscriptionCommand}"
										Content="{x:Bind ViewModel.SubscriptionButtonText, Mode=OneWay}" />

								</StackPanel>

								<MenuFlyoutSeparator />
							</StackPanel>

							<StackPanel Spacing="12">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource BodyStrongTextBlockStyle}"
										Text="Participants" />
								</StackPanel>

								<Grid>

									<ItemsRepeater ItemsSource="{x:Bind ViewModel.PullItem.Participants.Nodes, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Orientation="Horizontal" Spacing="8" />
										</ItemsRepeater.Layout>
										<DataTemplate x:DataType="modelsV4:User">
											<primer:Avatar
												HorizontalAlignment="Left"
												Size="28"
												Source="{x:Bind AvatarUrl, Mode=OneWay}" />
										</DataTemplate>
									</ItemsRepeater>

									<TextBlock
										x:Name="PullRequestDetailsSidebarNoParticipantsTextBlock"
										x:Load="{x:Bind ViewModel.PullItem.Participants.Nodes.Count, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="No participants" />
								</Grid>

								<MenuFlyoutSeparator />
							</StackPanel>

						</StackPanel>

					</Grid>

					<Grid
						Grid.Row="3"
						Background="{ThemeResource LayerFillColorDefaultBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<Grid>
							<NavigationView
								Margin="12,4,24,4"
								IsBackButtonVisible="Collapsed"
								IsSettingsVisible="False"
								PaneDisplayMode="Top">
								<NavigationView.MenuItems>
									<NavigationViewItem
										Content="Write"
										IsEnabled="False"
										IsSelected="True" />
									<NavigationViewItem Content="Preview" IsEnabled="False" />
								</NavigationView.MenuItems>

								<NavigationView.PaneFooter>
									<StackPanel Orientation="Horizontal" Spacing="4">
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xE9CD;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xEAA7;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xEA0F;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xE968;" />
										</Button>
										<Button
											Width="32"
											Height="32"
											Padding="0"
											Background="Transparent"
											BorderThickness="0"
											IsEnabled="False">
											<FontIcon
												FontFamily="{StaticResource Octicons}"
												FontSize="14"
												Glyph="&#xEA50;" />
										</Button>
									</StackPanel>
								</NavigationView.PaneFooter>

							</NavigationView>
						</Grid>

						<MenuFlyoutSeparator Grid.Row="1" />

						<Grid
							Grid.Row="2"
							Height="256"
							Background="{ThemeResource LayerFillColorDefaultBrush}">
							<TextBox
								Margin="12"
								Background="{ThemeResource LayerFillColorDefaultBrush}"
								PlaceholderText="Leave a comment"
								Text="{x:Bind ViewModel.CommentBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>

						<Grid
							Grid.Row="3"
							Padding="12,0,12,12"
							Background="{ThemeResource LayerFillColorDefaultBrush}">

							<StackPanel
								HorizontalAlignment="Right"
								Orientation="Horizontal"
								Spacing="8">
								<Button
									Click="OnEditPullRequestClicked"
									Content="Edit"
									IsEnabled="{x:Bind ViewModel.CanEditPullRequest, Mode=OneWay}" />
								<Button
									Click="OnReviewClicked"
									Content="Review"
									IsEnabled="{x:Bind ViewModel.CanSubmitReview, Mode=OneWay}" />
								<Button
									Content="Merge"
									IsEnabled="{x:Bind ViewModel.CanMergePullRequest, Mode=OneWay}">
									<Button.Flyout>
										<MenuFlyout>
											<MenuFlyoutItem Click="OnMergeClicked" Tag="Merge" Text="Create a merge commit" />
											<MenuFlyoutItem Click="OnMergeClicked" Tag="Squash" Text="Squash and merge" />
											<MenuFlyoutItem Click="OnMergeClicked" Tag="Rebase" Text="Rebase and merge" />
										</MenuFlyout>
									</Button.Flyout>
								</Button>
								<Button
									Command="{x:Bind ViewModel.ToggleStateCommand}"
									Content="{x:Bind ViewModel.PullRequestStateButtonText, Mode=OneWay}" />
								<Button
									Content="Comment"
									Command="{x:Bind ViewModel.AddCommentCommand}"
									Style="{StaticResource AccentButtonStyle}" />
							</StackPanel>
						</Grid>

					</Grid>

				</Grid>
			</ScrollViewer>
		</Grid>

		<Grid x:Name="ErrorDisplayingContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Mode=OneWay}">
			<uc:LoadErrorDisplay
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				TaskException="{x:Bind ViewModel.TaskException, Mode=OneWay}">
				<uc:LoadErrorDisplay.Action>
					<Grid>
						<Button
							Margin="0,24,0,0"
							HorizontalAlignment="Center"
							Command="{x:Bind ViewModel.LoadRepositoryPullRequestConversationPageCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="16" Glyph="&#xE149;" />
								<TextBlock Text="{helpers:ResourceString Name=TryAgainWithCap}" />
							</StackPanel>
						</Button>
					</Grid>
				</uc:LoadErrorDisplay.Action>
			</uc:LoadErrorDisplay>
		</Grid>

	</Grid>
</views:LocatablePage>
