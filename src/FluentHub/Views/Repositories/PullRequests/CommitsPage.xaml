<navigation:NavigableView
	x:Class="FluentHub.Views.Repositories.PullRequests.CommitsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bb="using:FluentHub.Controls.BlockButtons"
	xmlns:bbvm="using:FluentHub.ViewModels.Controls.BlockButtons"
	xmlns:converters="using:FluentHub.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:FluentHub.Helpers"
	xmlns:local="using:FluentHub.Views.Repositories.PullRequests"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ov="using:FluentHub.Controls.Overview"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:uc="using:FluentHub.Controls"
	xmlns:navigation="using:FluentHub.Controls.Navigation"
	mc:Ignorable="d">

	<navigation:NavigableView.Resources>
		<ResourceDictionary>
			<converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
		</ResourceDictionary>
	</navigation:NavigableView.Resources>

	<Grid>

		<Grid x:Name="RootContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
			<ScrollViewer>
				<Grid Padding="32,24,32,32" RowSpacing="16">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<ov:PullRequestOverview Grid.Row="0" ViewModel="{x:Bind ViewModel.PullRequestOverviewViewModel, Mode=OneWay}" />

					<Grid Grid.Row="1">
						<ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
							<ItemsRepeater.Layout>
								<StackLayout Orientation="Vertical" Spacing="4" />
							</ItemsRepeater.Layout>
							<DataTemplate x:DataType="bbvm:CommitBlockButtonViewModel">
								<bb:CommitBlockButton ViewModel="{x:Bind}" />
							</DataTemplate>
						</ItemsRepeater>
					</Grid>
				</Grid>
			</ScrollViewer>
		</Grid>

		<Grid x:Name="ErrorDisplayingContentGrid" x:Load="{x:Bind ViewModel.IsTaskFaulted, Mode=OneWay}">
			<uc:LoadErrorDisplay
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				TaskException="{x:Bind ViewModel.TaskException, Mode=OneWay}">
				<uc:LoadErrorDisplay.Action>
					<Grid>
						<Button
							Margin="0,24,0,0"
							HorizontalAlignment="Center"
							Command="{x:Bind ViewModel.LoadRepositoryPullRequestCommitsPageCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="16" Glyph="&#xE149;" />
								<TextBlock Text="{helpers:ResourceString Name=TryAgainWithCap}" />
							</StackPanel>
						</Button>
					</Grid>
				</uc:LoadErrorDisplay.Action>
			</uc:LoadErrorDisplay>
		</Grid>

	</Grid>
</navigation:NavigableView>
