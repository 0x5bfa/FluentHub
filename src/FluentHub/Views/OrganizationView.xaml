<UserControl
	x:Class="FluentHub.Views.OrganizationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentHub.Controls"
	xmlns:markdown="using:CommunityToolkit.WinUI.Controls">

	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Padding="24" Spacing="16">
			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<PathIcon
					Width="32"
					Height="32"
					Data="{controls:OcticonData Name=Organization24}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<StackPanel Grid.Column="1" Spacing="2">
					<TextBlock
						Style="{StaticResource TitleTextBlockStyle}"
						Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
						TextWrapping="Wrap" />
					<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Login, Mode=OneWay}" />
				</StackPanel>
			</Grid>

			<ProgressRing
				x:Name="LoadingIndicator"
				Width="40"
				Height="40"
				HorizontalAlignment="Center"
				x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
				IsActive="True" />

			<StackPanel
				x:Name="ContentPanel"
				x:Load="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
				Spacing="16">
				<markdown:MarkdownTextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Click="OnRepositoriesClick" Content="Repositories" />
					<Button Click="OnOverviewClick" Content="Overview" />
				</StackPanel>
				<TextBlock
					x:Name="LocationText"
					x:Load="{x:Bind ViewModel.HasLocation, Mode=OneWay}"
					Text="{x:Bind ViewModel.Location, Mode=OneWay}" />
				<Button
					x:Name="WebsiteButton"
					x:Load="{x:Bind ViewModel.HasWebsite, Mode=OneWay}"
					Click="OnWebsiteClick"
					Content="Website" />
			</StackPanel>

			<StackPanel
				x:Name="ErrorPanel"
				HorizontalAlignment="Center"
				x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
				Spacing="8">
				<SymbolIcon
					HorizontalAlignment="Center"
					Foreground="{ThemeResource SystemFillColorCriticalBrush}"
					Symbol="Important" />
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource SubtitleTextBlockStyle}"
					Text="Organization unavailable" />
				<TextBlock
					HorizontalAlignment="Center"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
					TextWrapping="Wrap" />
				<Button
					x:Name="RetryButton"
					HorizontalAlignment="Center"
					Command="{x:Bind ViewModel.RetryCommand}"
					Content="Try again" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
